{
  "$id": "streak.result/1.0",
  "title": "STREAK raw result file (one record per learner-arm), version 1.0",
  "type": "object",
  "required": ["schema_version", "experiment_id", "label", "simulation_notice", "protocol_version", "config_hash", "engine_version", "package_version", "config", "cells", "records", "n_records", "n_failed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "streak.result/1.0"},
    "experiment_id": {"type": "string"},
    "label": {"enum": ["exploratory", "confirmatory"]},
    "simulation_notice": {"type": "string"},
    "protocol_version": {"type": "string"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "engine_version": {"type": "string"},
    "package_version": {"type": "string"},
    "config": {"type": "object"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cell_id", "params"],
        "additionalProperties": false,
        "properties": {"cell_id": {"type": "string"}, "params": {"type": "object"}}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "cell_id", "master_seed", "learner_index", "arm", "status", "error", "metrics"],
        "additionalProperties": false,
        "properties": {
          "run_id": {"type": "string"},
          "cell_id": {"type": "string"},
          "master_seed": {"type": "integer", "minimum": 0},
          "learner_index": {"type": "integer", "minimum": 0},
          "arm": {"type": "string"},
          "status": {"enum": ["ok", "error"]},
          "error": {"type": ["string", "null"]},
          "metrics": {
            "type": ["object", "null"],
            "required": ["R30", "AUC_R", "weakest_decile_R30", "minutes_spent", "slots_spent", "residual_slots", "reviews", "active_days", "longest_streak", "final_streak", "missed_unavailable_days", "missed_available_days", "practice_success_rate", "item_coverage", "residual_flag"],
            "properties": {
              "R30": {"type": "number", "minimum": 0, "maximum": 1},
              "AUC_R": {"type": "number", "minimum": 0, "maximum": 1},
              "weakest_decile_R30": {"type": "number", "minimum": 0, "maximum": 1},
              "minutes_spent": {"type": "number", "minimum": 0},
              "slots_spent": {"type": "integer", "minimum": 0},
              "residual_slots": {"type": "integer", "minimum": 0},
              "reviews": {"type": "integer", "minimum": 0},
              "active_days": {"type": "integer", "minimum": 0},
              "longest_streak": {"type": "integer", "minimum": 0},
              "final_streak": {"type": "integer", "minimum": 0},
              "missed_unavailable_days": {"type": "integer", "minimum": 0},
              "missed_available_days": {"type": "integer", "minimum": 0},
              "practice_success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "item_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "residual_flag": {"type": "boolean"}
            }
          }
        }
      }
    },
    "n_records": {"type": "integer", "minimum": 0},
    "n_failed": {"type": "integer", "minimum": 0}
  }
}
